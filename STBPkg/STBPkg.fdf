[Defines]
  INF_VERSION                    = 0x00010005
  PLATFORM_NAME                  = STBPkg
  PLATFORM_GUID                  = 12345678-abcd-ef01-2345-6789abcdef01
  PLATFORM_VERSION               = 0.1
  FLASH_DEFINITION               = STBPkg/STBPkg.fdf

[FV.FvMain]
  BlockSize          = 0x10000
  NumBlocks          = 0x20
  FvAlignment        = 16
  ERASE_POLARITY     = 1
  MEMORY_MAPPED      = TRUE
  STICKY_WRITE       = TRUE
  LOCK_STATUS        = TRUE
  UNLOCK_STATUS      = TRUE

  INF STBPkg/Application/Main/Main.inf

[FD.STBFlashRom]
  BaseAddress   = 0xFFF00000
  Size          = 0x00200000
  ErasePolarity = 1
  BlockSize     = 0x10000
  NumBlocks     = 32

  FV = FvMain
